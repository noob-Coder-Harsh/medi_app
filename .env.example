# Copy to .env or .env.local (gitignored) or pass via --dart-define.
# Never put SUPABASE_SERVICE_ROLE_KEY or Firebase admin JSON in the app.

SUPABASE_URL=
SUPABASE_ANON_KEY=
API_BASE_URL=

# Public Firebase web/app keys (also accepts NEXT_PUBLIC_FIREBASE_* aliases).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
